{
  "name": "rubyn-harness",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'scripts/**'",
    "test:fixture": "node --test scripts/prepare-beta-fixture.test.mjs scripts/create-acceptance-run.test.mjs scripts/record-acceptance-checkpoint.test.mjs",
    "acceptance:create": "node scripts/create-acceptance-run.mjs",
    "acceptance:record": "node scripts/record-acceptance-checkpoint.mjs",
    "test:release": "node --test scripts/release-contract.test.mjs",
    "test:performance": "node --test scripts/check-build-budget.test.mjs scripts/measure-native-performance.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "release:check": "node scripts/release-contract.mjs",
    "performance:check": "node scripts/check-build-budget.mjs",
    "performance:native": "node scripts/measure-native-performance.mjs",
    "release:macos": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
